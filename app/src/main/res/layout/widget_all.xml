            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l0" android:contentDescription="@null" />
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l1" android:contentDescription="@null" />
            <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
