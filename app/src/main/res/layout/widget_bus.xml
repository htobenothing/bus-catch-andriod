<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/dog"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_dog"
            android:visibility="gone"
            android:contentDescription="@null" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/stopName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/paper"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Bus Catch" />
            <TextView
                android:id="@+id/updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/dim"
                android:maxLines="1"
                android:text="" />
        </LinearLayout>
        <ImageView
            android:id="@+id/bell"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_bell_off"
            android:contentDescription="Turn leave alert on or off" />
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="7dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/leave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/led"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <ListView
        android:id="@+id/busList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:textSize="13sp"
        android:textColor="@color/paper"
        android:visibility="gone"
        android:text="" />


    <ViewFlipper
        android:id="@+id/dogRunSlow"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:autoStart="true"
        android:flipInterval="130"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r0" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="7" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r1" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r2" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="5" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="3" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r3" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r0" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="3" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="5" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r1" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r2" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="7" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r3" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="7" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l0" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l1" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="5" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l2" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l3" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="3" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="3" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l0" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l1" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="5" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l2" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l3" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="7" />
        </LinearLayout>
    </ViewFlipper>
    <ViewFlipper
        android:id="@+id/dogRunFast"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:autoStart="true"
        android:flipInterval="70"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r0" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="7" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r1" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r2" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="5" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="3" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r3" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r0" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="3" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="5" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r1" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r2" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="7" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_r3" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="7" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l0" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l1" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="5" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l2" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l3" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="3" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="3" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l0" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="4" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="2" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l1" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="5" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l2" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="6" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="0" />
            <ImageView android:layout_width="40dp" android:layout_height="28dp" android:src="@drawable/dog_run_l3" android:contentDescription="@null" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="7" />
