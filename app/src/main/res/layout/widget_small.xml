<?xml version="1.0" encoding="utf-8"?>
<!-- 3x1 and wider: stop name, leave line, refresh -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/sStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/dim"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Bus Catch" />
        <TextView
            android:id="@+id/sLeave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/led"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>
    <ImageView
        android:id="@+id/bell"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_bell_off"
        android:contentDescription="Turn leave alert on or off" />
    <ImageView
        android:id="@+id/refresh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="7dp"
        android:src="@drawable/ic_refresh"
        android:contentDescription="Refresh" />
</LinearLayout>
