<?xml version="1.0" encoding="utf-8"?>
<!-- 3x1: big leave time | bus + stop | bell -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/dog"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/ic_dog"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/sLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:textColor="@color/dim"
            android:maxLines="1"
            android:text="LEAVE" />
        <TextView
            android:id="@+id/sBig"
            android:layout_width="78dp"
            android:layout_height="30dp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textColor="@color/led"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeStepGranularity="1sp"
            android:text="--:--" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/sBus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="@color/paper"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
        <TextView
            android:id="@+id/sStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/dim"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Bus Pup" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bell"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="7dp"
        android:src="@drawable/ic_bell_off"
        android:contentDescription="Turn leave alert on or off" />
</LinearLayout>
